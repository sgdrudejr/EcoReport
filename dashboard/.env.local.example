# Fill these values in dashboard/.env.local on your Mac Mini.
# This file is safe to commit as a template.

# Required for dashboard data fetching and report tooling
GEMINI_API_KEY=

# Optional override. Default is gemini-2.5-flash.
GEMINI_PORTFOLIO_MODEL=gemini-2.5-flash

# Required if you want local saves and trigger requests to sync to GitHub automatically.
# Used by:
# - /api/trigger
GITHUB_TOKEN=
