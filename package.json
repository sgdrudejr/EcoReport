    "parallel:search": "node scripts/search-parallel-rag.js",
    "fetch:rss": "node scripts/fetch-rss-news.js",
    "fetch:twitter": "node scripts/fetch-twitter.js",
    "fetch:market": "node scripts/fetch-market-data.js",
    "fetch:market:lite": "node scripts/fetch-market-data-lite.js",
    "fetch:marketvoice": "node scripts/collect-marketvoice-news.js",
    "intraday:alerts": "node scripts/run-intraday-alert-pipeline.js",
