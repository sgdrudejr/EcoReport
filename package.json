  "dependencies": {
    "@anthropic-ai/sdk": "^0.55.0",
    "better-sqlite3": "^11.0.0",
    "date-fns": "^3.0.0",
    "dotenv": "^16.4.0",
    "node-fetch": "^3.3.0",
    "pdf-parse": "^1.1.1",
    "playwright": "^1.40.0",
    "rss-parser": "^3.13.0",
    "technicalindicators": "^3.1.0"
