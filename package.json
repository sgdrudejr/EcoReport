    "compress:reports": "node scripts/compress-reports.js",
    "synthesize:daily": "node scripts/synthesize-daily.js",
    "build:context": "node scripts/build-context.js",
    "backtest:collect": "node scripts/backtest-collect.js",
    "backtest:engine": "node scripts/backtest-engine.js",
    "backtest:report": "node scripts/backtest-report.js",
    "briefing:fidelity": "node scripts/validate-briefing-fidelity.js",
    "verify": "node scripts/verify-daily-system.js",
    "daily": "npm run automation:daily",
    "daily:baseline": "bash scripts/run-daily-system.sh --baseline-only",
    "daily:quality": "bash scripts/run-quality-gated-cycle.sh"
