      "number": "01",
      "key": "report_collection",
      "name": "Report Collection",
      "korean": "리포트 수집",
      "primaryCommand": "npm run step01:report-collection -- --date YYYY-MM-DD",
      "primaryOutputs": [
        "data/reports/YYYY-MM-DD/index.json",
        "data/reports/YYYY-MM-DD/text-manifest.json",
        "data/portfolio/latest.json",
        "data/market/YYYY-MM-DD.json"
      ]
    },
    {
      "number": "02",
      "key": "chunk_summary",
      "name": "Chunk Summary",
      "korean": "청크 요약",
      "primaryCommand": "npm run step02:chunk-summary -- --date YYYY-MM-DD",
      "primaryOutputs": [
        "data/analysis-state/YYYY-MM-DD/stage1-chunk-summaries.json",
        "reports/report_summaries/YYYY-MM-DD/"
      ]
    },
    {
      "number": "03",
      "key": "report_indexing",
      "name": "Report Indexing",
      "korean": "리포트 인덱싱",
