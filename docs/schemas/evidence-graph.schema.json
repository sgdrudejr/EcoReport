{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ecoreport.local/schemas/evidence-graph.schema.json",
  "title": "EcoReport Evidence Graph",
  "type": "object",
  "required": [
    "date",
    "graphId",
    "generatedAt",
    "entities",
    "edges"
  ],
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "graphId": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string"
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "entity": {
      "type": "object",
      "required": [
        "entityId",
        "entityType",
        "name"
      ],
      "properties": {
        "entityId": {
          "type": "string"
        },
        "entityType": {
          "type": "string",
          "enum": [
            "security",
            "account",
            "theme",
            "sector",
            "macro_event",
            "category",
            "report",
            "strategy_rule"
          ]
        },
        "name": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metadata": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": [
        "edgeId",
        "from",
        "to",
        "relation",
        "weight",
        "confidence",
        "sourceObservations"
      ],
      "properties": {
        "edgeId": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "relation": {
          "type": "string",
          "enum": [
            "supports",
            "opposes",
            "mentions",
            "belongs_to",
            "mapped_to",
            "translates_to",
            "hedges",
            "raises_risk_for",
            "preferred_for",
            "candidate_for",
            "derived_from"
          ]
        },
        "direction": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "positive",
            "negative",
            "neutral",
            "mixed",
            null
          ]
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sourceObservations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "qualityFlags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metadata": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  }
}
