{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sgdrudejr/EcoReport/docs/schemas/llm-exchange.v1.schema.json",
  "title": "EcoReport LLM Exchange Packet v1",
  "type": "object",
  "required": ["schemaVersion", "contract", "audience", "date", "tokenPolicy"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contract": {
      "type": "string",
      "enum": [
        "ecoreport.llm.research_context.v1",
        "ecoreport.llm.portfolio_action_context.v1",
        "ecoreport.llm.claim_review_context.v1",
        "ecoreport.llm.source_audit_map.v1",
        "ecoreport.llm.exchange_manifest.v1"
      ]
    },
    "audience": {
      "type": "string",
      "enum": ["ai_to_ai", "small_prompt_review", "human_manifest"]
    },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "runDate": { "type": ["string", "null"] },
    "effectiveMarketDate": { "type": ["string", "null"] },
    "runId": { "type": ["string", "null"] },
    "tokenPolicy": {
      "type": "object",
      "required": ["fullTextExcluded", "maxClaimChars", "sourceIdsOnly"],
      "properties": {
        "fullTextExcluded": { "type": "boolean" },
        "maxClaimChars": { "type": "integer", "minimum": 60, "maximum": 360 },
        "sourceIdsOnly": { "type": "boolean" },
        "approxTokenBudget": { "type": "integer", "minimum": 500, "maximum": 60000 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
