# ──────────────────────────────────────────────────────────────────────────────
# EcoReport 환경변수 템플릿
# 이 파일을 .env 로 복사한 후 실제 키를 채워주세요.
# cp .env.example .env
# ──────────────────────────────────────────────────────────────────────────────

# [필수] Google Gemini API — Stage 2 전략 분석 + 일일 브리핑
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# [권장] Qwen(DashScope) API — Stage 1.4b 어젠다/Stage 2 전략 생성
# https://www.alibabacloud.com/help/model-studio
DASHSCOPE_API_KEY=
# DASHSCOPE_API_KEY와 동일하게 사용 가능
QWEN_API_KEY=

# [선택] Windows LM Studio 로컬 LLM — Stage 1.4a 청크 요약
# 우선순위: .env -> config/local-report-orchestrator.json -> 기본값(http://localhost:1234/v1)
LOCAL_LLM_BASE_URL=http://localhost:1234/v1
# 모델명 미지정 시 .env -> local-report-orchestrator.json -> /v1/models 첫 번째 모델 순서로 결정
LOCAL_LLM_MODEL=
# compress-reports fallback 시 잘라서 보낼 최대 본문 길이
LOCAL_LLM_MAX_CHARS=1500
# compress-reports fallback 시 동시 처리 개수
LOCAL_LLM_CONCURRENCY=1
# compress-reports fallback 요청 타임아웃(ms)
LOCAL_LLM_TIMEOUT_MS=120000

# [필수] Anthropic Claude API — 리포트 압축(compress-reports) + 일일 합성(synthesize-daily)
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# [권장] FRED (Federal Reserve Economic Data) — 거시경제 지표 수집
# https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# [선택] 한국은행 ECOS API — 국내 거시경제 지표
# https://ecos.bok.or.kr/api/#/AuthKeyApply
BOK_API_KEY=

# [선택] EcoReport 루트 디렉토리 override (기본: 스크립트 상대경로 자동 감지)
# 다른 경로에 클론했거나 symlink 사용 시 설정
# ECOREPORT_ROOT=/path/to/ecoreport
